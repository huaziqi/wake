[sub_resource type="GDScript" id="GDScript_14oti"]
script/source = "extends Node2D
@onready var collision_shape_2d=$Area2D/CollisionShape2D
@onready var sprite=$Sprite2D
@export var adsorption_audio : AudioStream
func _ready() -> void:
	$Area2D.area_entered.connect(on_area_entered)
	
func tween_collect(percent:float,start_position:Vector2):
	var player=get_tree().get_first_node_in_group(\"player\")
	if player==null:
		return
		
	global_position=start_position.lerp(player.global_position,percent)#percent插值增进
	var direction_from_start=global_position-start_position  #获取玩家的位置，
	
	var target_rotation= direction_from_start.angle()	+deg_to_rad(90)
	rotation=lerp_angle(rotation,target_rotation,1-exp(-2*get_process_delta_time() ))#吸收dna，先让dna旋转指向玩家
	
	
func collect():
	Gameevent.emit_dna_collected(1)
	MusicManager.play_sfx(adsorption_audio)
	queue_free()
	
func disable_collision():
	collision_shape_2d.disabled=true
	
func on_area_entered(other_area:Area2D):
	Callable(disable_collision).call_deferred()
	
	var tween=create_tween()     #tween函数类似于ppt里的平滑一样的功能，适合制作丝滑小动画
	tween.set_parallel()     #如果没paralle，会让所有tween函数依次执行
	tween.tween_method(tween_collect.bind(global_position),0.0,1.0,.5)\\
	.set_ease(Tween.EASE_IN)\\
	.set_trans(Tween.TRANS_BACK)
	#曲线#飞向玩家
	tween.tween_property(sprite,\"scale\",Vector2.ZERO,.15).set_delay(.35) #缩放动画，在0.35秒后进行，0.15秒内完成动画，也就是共0.5s
	tween.chain()	#chain是等上面先执行了后执行下面
	tween.tween_callback(collect)	#动画结束，并执行collect函数
"

